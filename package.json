{
  "name": "ai-study-planner",
  "version": "2.0.0",
  "description": "AI Study Planner - NGINX Gateway + TypeScript Microservices Architecture",
  "private": true,
  "workspaces": [
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev --workspace=services/user-service\" \"npm run dev --workspace=services/ai-schedule-service\"",
    "start": "npm run start --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:user": "npm run test --workspace=services/user-service",
    "test:schedule": "npm run test --workspace=services/ai-schedule-service",
    "lint": "npm run lint --workspaces --if-present",
    "lint:user": "npm run lint --workspace=services/user-service",
    "lint:schedule": "npm run lint --workspace=services/ai-schedule-service",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf dist",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:health": "bash scripts/dev-helper.sh",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GauravSharmaCode/AI-Study-Planner.git"
  },
  "keywords": [
    "AI",
    "Study",
    "Planner",
    "TypeScript",
    "Microservices",
    "Docker",
    "Prisma"
  ],
  "author": {
    "name": "Gaurav Sharma",
    "github": "@GauravSharmaCode",
    "email": "shrma.gurv@gmail.com"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GauravSharmaCode/AI-Study-Planner/issues"
  },
  "homepage": "https://github.com/GauravSharmaCode/AI-Study-Planner#readme",
  "devDependencies": {
    "@types/node": "^22.9.1",
    "typescript": "^5.7.2",
    "concurrently": "^9.1.0",
    "rimraf": "^6.0.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1"
  },
  "dependencies": {
    "axios": "^1.8.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
