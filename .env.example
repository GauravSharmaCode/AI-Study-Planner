# Environment Configuration for AI Study Planner

# ===========================================
# COMMON CONFIGURATION
# ===========================================
NODE_ENV=development
LOG_LEVEL=info

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Replace with your actual database URL
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/ai_study_planner"

# ===========================================
# API GATEWAY CONFIGURATION (Port 3000)
# ===========================================
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Service URLs (for API Gateway)
USER_SERVICE_URL=http://localhost:3001
AI_SCHEDULE_SERVICE_URL=http://localhost:3002

# ===========================================
# USER SERVICE CONFIGURATION (Port 3001)
# ===========================================
USER_SERVICE_PORT=3001
SERVICE_NAME=user-service

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12

# Rate Limiting (User Service)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# AI SCHEDULE SERVICE CONFIGURATION (Port 3002)
# ===========================================
AI_SCHEDULE_SERVICE_PORT=3002

# Ollama Cloud AI Configuration
# Get your API key from https://ollama.com
# Recommended models: gpt-oss:120b (powerful), qwen3.5 (balanced), nemotron-3-super (advanced reasoning)
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=gpt-oss:120b

# AI API Retry Configuration
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_INITIAL_DELAY_MS=1000
AI_RETRY_MAX_DELAY_MS=10000

# ===========================================
# REDIS CONFIGURATION (Optional)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# PRISMA CONFIGURATION
# ===========================================
# Database logging
DB_LOG_QUERIES=false
DB_LOG_SLOW_QUERIES=true
DB_SLOW_QUERY_THRESHOLD=1000

# Connection Pool Settings (Applied via DATABASE_URL query params)
# connection_limit: Maximum number of database connections (default: 10)
# pool_timeout: Max time to wait for connection in seconds (default: 20)
# connect_timeout: Max time to establish connection in seconds (default: 10)

# ===========================================
# DOCKER CONFIGURATION
# ===========================================
# Docker-specific overrides (when running in containers)
# DATABASE_URL="postgresql://postgres:postgres123@postgres:5432/ai_study_planner"
# REDIS_URL="redis://redis:6379"
# USER_SERVICE_URL=http://user-service:3001
# AI_SCHEDULE_SERVICE_URL=http://ai-schedule-service:3002
# CORS_ORIGIN=http://localhost:3000
