generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AI Schedule Service - Updated to match MVP requirements
model StudyPlan {
  id                    String   @id @default(uuid())
  userId                String   // Reference to User service (no FK constraint)
  subjects              String[] // ["Math", "Physics"]
  availableHoursPerDay  Int      // 4
  targetCompletionDate  DateTime // "2025-09-01"
  plan                  Json     // Entire JSON plan structure
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  sessions StudySession[]
  
  @@index([userId])
  @@map("study_plans")
}

model StudySession {
  id          String   @id @default(uuid())
  studyPlanId String
  date        String   // "2025-08-12"
  topic       String   // "Algebra"
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  status      String   @default("pending") // "pending", "completed", "skipped"
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  
  @@index([studyPlanId])
  @@index([date])
  @@map("study_sessions")
}
